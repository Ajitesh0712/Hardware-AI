# Google Gemini is used for natural-language requirement parsing and optional summaries.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional MySQL persistence. The recommendation flow can return results when
# the database is unavailable; the app logs a warning and continues.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hardwareai
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Flask development server; defaults to 5001.
PORT=5001
FLASK_ENV=development
