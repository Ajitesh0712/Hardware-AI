# ── Anthropic Claude API ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── RapidAPI (Amazon Real-Time Data) ─────────────────
# Get from: https://rapidapi.com/real-time-amazon-data/api/real-time-amazon-data
RAPIDAPI_KEY=your_rapidapi_key_here

# ── MySQL Database ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hardwareai
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── Flask Config ──────────────────────────────────────
FLASK_ENV=development
PORT=5000
